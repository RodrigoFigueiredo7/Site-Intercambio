# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# .env.local nunca e commitado (ver .gitignore).
#
# Onde achar: Supabase Dashboard > Project Settings > API Keys

# Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Chave "anon / public". Publica por design: vai embutida no bundle do browser.
# Quem protege os dados e o RLS, nao o segredo desta chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role / secret". IGNORA O RLS POR COMPLETO.
# So no servidor, so na pagina publica /s/[token] (etapa 6).
# Nunca prefixar com NEXT_PUBLIC_, nunca importar em componente de cliente.
SUPABASE_SERVICE_ROLE_KEY=
